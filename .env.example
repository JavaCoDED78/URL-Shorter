# ===================================================================
# URL Shortener — Project Configuration
# ===================================================================
# All runtime configuration is externalized via environment variables.
# Copy this file to .env and adjust values for your environment.
# Never commit .env — it is listed in .gitignore.
# ===================================================================

# -------------------------------------------------------------------
# Spring / Application
# -------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/urlshortener
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

SERVER_PORT=8080

# Shortener behaviour
SHORTENER_CODE_LENGTH=7
SHORTENER_URL_MAX_LENGTH=2048
SHORTENER_ALIAS_MAX_LENGTH=64
SHORTENER_MAX_COLLISION_RETRIES=5
SHORTENER_CACHE_TTL=1h
SHORTENER_FLUSH_INTERVAL=PT5S
SHORTENER_MAX_PAYLOAD_SIZE=16KB
SHORTENER_BENCHMARK_ENABLED=false

# -------------------------------------------------------------------
# Redis
# -------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TIMEOUT=2s

# -------------------------------------------------------------------
# PostgreSQL (used by Docker Compose)
# -------------------------------------------------------------------
POSTGRES_DB=urlshortener
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# -------------------------------------------------------------------
# Application port (Docker Compose)
# -------------------------------------------------------------------
APP_PORT=8080

# -------------------------------------------------------------------
# Prometheus
# -------------------------------------------------------------------
PROMETHEUS_PORT=9090

# -------------------------------------------------------------------
# Grafana
# -------------------------------------------------------------------
GRAFANA_PORT=14000
GRAFANA_ADMIN_PASSWORD=admin
